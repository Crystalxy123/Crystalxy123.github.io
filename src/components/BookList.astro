---
import { books } from '../data/books';
import { t } from '../data/site';
import type { Lang } from '../data/site';

const { lang } = Astro.props as { lang: Lang };
---

<ol class="reading-list" role="list">
  {books.map((book, index) => (
    <li>
      <article class="book-entry" id={book.id} aria-labelledby={`${book.id}-title`}>
        <span class="book-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="book-copy">
          <p class="book-category">{t(book.category, lang)}</p>
          <h2 id={`${book.id}-title`}>{t(book.title, lang)}</h2>
          <p class="book-author">{t(book.author, lang)}<span>{lang === 'zh' ? '著' : 'Author'}</span></p>
          <p class="book-description">{t(book.description, lang)}</p>
          <a class="book-source" href={book.sourceUrl} target="_blank" rel="noopener noreferrer">{lang === 'zh' ? '图书资料' : 'Book details'} <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </li>
  ))}
</ol>

<style>
  .reading-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-entry {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    padding-block: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line-strong);
    scroll-margin-top: 110px;
  }

  .reading-list > li:last-child .book-entry {
    border-bottom: 1px solid var(--line);
  }

  .book-number {
    color: var(--ink-soft);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .book-copy {
    min-width: 0;
    max-width: 700px;
  }

  .book-category {
    margin-bottom: 18px;
    color: var(--ink-soft);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .book-copy h2 {
    margin: 0 0 24px;
    font-family: "Noto Serif SC", "Songti SC", "STSong", Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
  }

  .book-author {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
    font-size: 1rem;
  }

  .book-author span {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .book-description {
    max-width: 580px;
    margin-bottom: 24px;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.9;
  }

  .book-source {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-block: 8px;
    font-size: 0.875rem;
    text-underline-offset: 5px;
  }

  @media (max-width: 600px) {
    .book-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
