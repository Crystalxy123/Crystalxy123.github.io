---
import { localizedPath } from '../data/navigation';
import { honors, profile, projects, publications, researchThemes, t, timeline } from '../data/site';
import type { Lang } from '../data/site';
import ProjectCard from './ProjectCard.astro';
import PublicationItem from './PublicationItem.astro';

const { lang } = Astro.props as { lang: Lang };
const featuredProjects = projects.filter((item) => item.featured).slice(0, 6);
const featuredPublications = publications.filter((item) => item.featured).slice(0, 6);
---

<section class="hero section-shell">
  <div class="hero-copy">
    <p class="kicker"><span></span>{t(profile.institution, lang)}</p>
    <h1>
      <span class="hero-name">{t(profile.name, lang)}</span>
      <span>{t(profile.headline, lang)}</span>
    </h1>
    <p class="hero-bio">{t(profile.shortBio, lang)}</p>
    <div class="hero-actions">
      <a class="button button-primary" href={localizedPath(lang, 'research')}>{lang === 'zh' ? '查看研究方向' : 'Explore research'}</a>
      <a class="button button-secondary" href={localizedPath(lang, 'projects')}>{lang === 'zh' ? '代表性成果' : 'Selected work'}</a>
      <a class="text-link" href={`mailto:${profile.email}`}>{lang === 'zh' ? '联系我' : 'Contact me'} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="cv-note">{lang === 'zh' ? '当前目录未发现可安全公开的正式 CV PDF；网页版履历已按本地资料整理。' : 'No verified public CV PDF was found in the supplied files; a source-checked web profile is provided instead.'}</p>
  </div>
  <div class="hero-visual" aria-label={lang === 'zh' ? '人因、人工智能与核安全关系示意' : 'Relationship between human factors, AI, and nuclear safety'}>
    <div class="portrait-frame">
      <picture>
        <source srcset="/images/xingyu-xiao.webp" type="image/webp" />
        <img src="/images/xingyu-xiao.jpg" alt={t(profile.name, lang)} width="800" height="1200" fetchpriority="high" />
      </picture>
      <div class="portrait-caption">
        <span>{lang === 'zh' ? '研究交叉点' : 'Research intersection'}</span>
        <strong>Human × AI × Safety</strong>
      </div>
    </div>
    <div class="system-map" aria-hidden="true">
      <span class="map-line line-a"></span><span class="map-line line-b"></span><span class="map-line line-c"></span>
      <span class="map-node node-human">Human</span>
      <span class="map-node node-ai">AI</span>
      <span class="map-node node-safety">Safety</span>
      <span class="map-core">HRA</span>
    </div>
  </div>
</section>

<section class="stats-strip" aria-labelledby="stats-title">
  <div class="section-shell">
    <div class="stats-heading">
      <p class="section-label" id="stats-title">{lang === 'zh' ? '研究概览' : 'Research at a glance'}</p>
      <p>{lang === 'zh' ? '约数，依据截至 2026 年 8 月的迁移任务资料；待最新正式 CV 最终核对。' : 'Approximate figures from the August 2026 migration brief, pending final reconciliation with a current formal CV.'}</p>
    </div>
    <dl class="stats-grid">
      {profile.stats.map((stat) => (
        <div>
          <dt>{lang === 'zh' ? stat.label.zh : stat.label.en}</dt>
          <dd>{lang === 'zh' ? stat.value : stat.enValue}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="content-section section-shell" aria-labelledby="research-heading">
  <div class="section-intro split-intro">
    <div>
      <p class="section-label">{lang === 'zh' ? '研究版图' : 'Research agenda'}</p>
      <h2 id="research-heading">{lang === 'zh' ? '从人的认知，到系统的安全边界' : 'From human cognition to system safety boundaries'}</h2>
    </div>
    <p>{lang === 'zh' ? '以真实运行问题为起点，将人因机制、数据建模与人工智能连接为一条可解释、可验证的研究链。' : 'Starting from real operational problems, I connect human-factor mechanisms, data modeling, and AI into an interpretable and verifiable research chain.'}</p>
  </div>
  <div class="theme-grid">
    {researchThemes.map((theme) => (
      <article class="theme-card">
        <span class="theme-code">{theme.code}</span>
        <h3>{t(theme.title, lang)}</h3>
        <p>{t(theme.description, lang)}</p>
        <div class="tag-row">{theme.tags.map((tag) => <span>{tag}</span>)}</div>
      </article>
    ))}
  </div>
  <a class="section-link" href={localizedPath(lang, 'research')}>{lang === 'zh' ? '查看完整研究框架' : 'View the full research framework'} <span>→</span></a>
</section>

<section class="content-section projects-band" aria-labelledby="projects-heading">
  <div class="section-shell">
    <div class="section-intro split-intro">
      <div>
        <p class="section-label">{lang === 'zh' ? '代表性成果' : 'Selected work'}</p>
        <h2 id="projects-heading">{lang === 'zh' ? '方法、系统与数据' : 'Methods, systems, and data'}</h2>
      </div>
      <p>{lang === 'zh' ? '成果状态严格区分“已发表研究”“研究原型”和“归档演示”，避免把实验性工作描述为工程部署。' : 'Work is explicitly labeled as published research, research prototype, or archived demo—never as deployed infrastructure without evidence.'}</p>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
    <a class="section-link" href={localizedPath(lang, 'projects')}>{lang === 'zh' ? '浏览全部项目' : 'Browse all projects'} <span>→</span></a>
  </div>
</section>

<section class="content-section section-shell" aria-labelledby="publications-heading">
  <div class="section-intro split-intro">
    <div>
      <p class="section-label">{lang === 'zh' ? '精选论文' : 'Selected publications'}</p>
      <h2 id="publications-heading">{lang === 'zh' ? '近期学术工作' : 'Recent academic work'}</h2>
    </div>
    <p>{lang === 'zh' ? '题录依据旧站内容数据和本地论文首页交叉核对。受版权限制，优先链接 DOI 或公开预印本。' : 'Records are cross-checked against legacy content data and local paper front matter. DOI and public preprint links are preferred over redistributed publisher PDFs.'}</p>
  </div>
  <div class="publication-list publication-list-home">
    {featuredPublications.map((publication) => <PublicationItem publication={publication} lang={lang} compact />)}
  </div>
  <a class="section-link" href={localizedPath(lang, 'publications')}>{lang === 'zh' ? '查看完整论文列表' : 'View all publications'} <span>→</span></a>
</section>

<section class="content-section journey-band" aria-labelledby="journey-heading">
  <div class="section-shell journey-grid">
    <div>
      <p class="section-label">{lang === 'zh' ? '学术路径' : 'Academic path'}</p>
      <h2 id="journey-heading">{lang === 'zh' ? '核工程、人因与智能系统的交叉成长' : 'Growing at the intersection of nuclear engineering, human factors, and intelligent systems'}</h2>
      <div class="timeline">
        {timeline.map((item) => (
          <article>
            <time>{lang === 'zh' ? item.period : item.periodEn}</time>
            <div><h3>{t(item.title, lang)}</h3><p>{t(item.detail, lang)}</p></div>
          </article>
        ))}
      </div>
    </div>
    <aside class="recognition-panel">
      <p class="section-label">{lang === 'zh' ? '学术认可' : 'Recognition'}</p>
      <ol>
        {honors.slice(0, 4).map((item) => <li><span>{item.year}</span><strong>{t(item.title, lang)}</strong></li>)}
      </ol>
      <a href={localizedPath(lang, 'honors')}>{lang === 'zh' ? '全部荣誉与经历' : 'All honors and experience'} →</a>
    </aside>
  </div>
</section>

<section class="contact-cta section-shell" aria-labelledby="contact-heading">
  <div>
    <p class="section-label">{lang === 'zh' ? '合作与交流' : 'Collaboration'}</p>
    <h2 id="contact-heading">{lang === 'zh' ? '面向更安全、更可信的核能智能化' : 'Toward safer and more trustworthy nuclear intelligence'}</h2>
  </div>
  <div>
    <p>{lang === 'zh' ? '欢迎围绕人因可靠性、数字化主控室、核电智能决策与高自治运行开展学术和项目交流。' : 'I welcome academic and project conversations on human reliability, digital control rooms, intelligent decision support, and high-autonomy nuclear operations.'}</p>
    <a class="button button-primary" href={localizedPath(lang, 'contact')}>{lang === 'zh' ? '建立联系' : 'Get in touch'}</a>
  </div>
</section>

