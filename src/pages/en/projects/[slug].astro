---
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { projects, t } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout lang="en" title={`${project.name} · ${t(project.fullName, 'en')}`} description={t(project.summary, 'en')} section="projects">
  <ProjectDetail lang="en" project={project} />
</BaseLayout>

